# VoiceSafeClaw Configuration
# Copy to .env and customize

# Wake word (default: "hey_jarvis")
WAKE_WORD=hey_jarvis

# Voice model for TTS ("piper" or "kokoro")
TTS_ENGINE=piper

# Whisper model size ("tiny", "base", "small")
STT_MODEL=tiny

# Log level ("DEBUG", "INFO", "WARNING", "ERROR")
LOG_LEVEL=INFO

# Sandbox mode (true = require approval for ALL actions)
SANDBOX_MODE=true

# Audio device index (leave empty for default)
AUDIO_DEVICE=

# Custom models directory (leave empty for default ./models/)
MODELS_DIR=
